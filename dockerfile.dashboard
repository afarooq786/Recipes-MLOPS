# Matches the Python version in Dockerfile.api -- keep these in sync since the
# dashboard shells out to the same project code (monitoring/, models/, data/).
FROM python:3.12-slim

WORKDIR /app

# Install project deps + streamlit. requirements.txt covers everything the
# monitoring scripts need (pandas, evidently, pandera, etc.); streamlit lives
# in requirements-dev.txt alongside pytest.
COPY requirements.txt requirements-dev.txt ./
RUN pip install --no-cache-dir -r requirements.txt -r requirements-dev.txt

# Full repo copy so `python -m monitoring.<script>` subprocess calls resolve
# correctly from /app, same as running them locally from the repo root.
COPY . .

EXPOSE 8501

CMD ["streamlit", "run", "monitoring/dashboard.py", \
     "--server.address=0.0.0.0", "--server.port=8501"]