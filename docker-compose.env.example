# Docker Compose Configuration Environment Variables Example
# Copy this file to .env locally if customization is needed.

# PostgreSQL backing store for Airflow
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow
POSTGRES_DB=airflow

# Airflow Admin Web UI credentials
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin

# MLflow Tracking & Model Registry URI inside docker network
MLFLOW_TRACKING_URI=http://mlflow:5000

# Champion Model Serving Configuration
MODEL_NAME=recipe-recommender
MODEL_ALIAS=champion
